{
  "schema_version": 2,
  "engine": "0.12.0",
  "packs": ["universal.authoring"],
  "releases": ".orly/rels",
  "commands": {
    "conform": {
      "argv": ["cargo", "fmt", "--all", "--", "--check"],
      "resources": ["cargo"]
    },
    "verify.lint": {
      "argv": ["cargo", "clippy", "--locked", "--workspace", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "resources": ["cargo"]
    },
    "verify.unit": {
      "argv": ["cargo", "test", "--locked", "--workspace", "--all-features"],
      "resources": ["cargo"],
      "deadline_seconds": 1800
    }
  },
  "allowed_executables": ["cargo"],
  "surfaces": {
    "user": ["src"],
    "docs": ["README.md", "docs"]
  }
}
