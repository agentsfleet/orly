{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataPack",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "engine_requirement": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "engine_requirement",
    "questions",
    "selectors",
    "capabilities",
    "policy"
  ],
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "kind": {
              "type": "string",
              "const": "check"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "capability",
            "inputs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "command"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "command_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition"
            },
            "kind": {
              "type": "string",
              "const": "select"
            },
            "on_false": {
              "type": "string"
            },
            "on_true": {
              "type": "string"
            },
            "question_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "question_id",
            "condition",
            "on_true",
            "on_false"
          ]
        }
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "candidate": {
              "type": "string"
            },
            "primitive": {
              "type": "string",
              "const": "choice"
            },
            "threshold": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "primitive",
            "candidate",
            "threshold"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "type": "string"
            },
            "primitive": {
              "type": "string",
              "const": "noul"
            },
            "threshold": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "primitive",
            "condition",
            "threshold"
          ]
        },
        {
          "type": "object",
          "properties": {
            "candidate": {
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "primitive": {
              "type": "string",
              "const": "score"
            },
            "threshold": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "primitive",
            "candidate",
            "level",
            "threshold"
          ]
        }
      ]
    },
    "Policy": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyNode"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "nodes"
      ]
    },
    "PolicyNode": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "dependencies",
        "required",
        "action"
      ]
    },
    "Primitive": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "choice"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noul"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "score"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "levels"
          ]
        }
      ]
    },
    "Question": {
      "type": "object",
      "properties": {
        "builder": {
          "type": "string"
        },
        "builder_version": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "primitive": {
          "$ref": "#/$defs/Primitive"
        },
        "rule_section": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "primitive",
        "id",
        "version",
        "builder",
        "builder_version",
        "model_version",
        "candidates",
        "rule_section"
      ]
    }
  }
}