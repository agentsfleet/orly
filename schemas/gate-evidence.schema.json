{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePacket",
  "type": "object",
  "properties": {
    "config_digest": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "engine": {
      "type": "string"
    },
    "invocations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CommandInvocation"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CriterionResult"
      }
    },
    "snapshot_digest": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "engine",
    "snapshot_digest",
    "config_digest",
    "results",
    "required",
    "invocations",
    "counts",
    "paths"
  ],
  "$defs": {
    "CommandInvocation": {
      "type": "object",
      "properties": {
        "command_digest": {
          "type": "string"
        },
        "config_digest": {
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "identity": {
          "type": "string"
        },
        "output_complete": {
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/CriterionResult"
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "snapshot_digest": {
          "type": "string"
        },
        "stderr_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stdout_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "command_digest",
        "snapshot_digest",
        "config_digest",
        "result",
        "stdout_bytes",
        "stderr_bytes",
        "output_complete"
      ]
    },
    "CriterionResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "passed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "skipped"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "reported"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "invocation": {
              "type": "string"
            },
            "original": {
              "$ref": "#/$defs/CriterionResult"
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "overridden"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "original",
            "invocation"
          ]
        }
      ]
    }
  }
}