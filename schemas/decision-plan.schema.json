{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionPlan",
  "type": "object",
  "properties": {
    "configuration_digest": {
      "type": "string"
    },
    "decisions_digest": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanNode"
      }
    },
    "pack_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "policy_digest": {
      "type": "string"
    },
    "snapshot_digest": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "snapshot_digest",
    "configuration_digest",
    "policy_digest",
    "decisions_digest",
    "pack_digests",
    "nodes",
    "digest"
  ],
  "$defs": {
    "CompiledAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capability": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "check"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "capability"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "command"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "command_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/CriterionResult"
            },
            "state": {
              "type": "string",
              "const": "resolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "question_id": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "unresolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "question_id"
          ]
        }
      ]
    },
    "CriterionResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "passed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "skipped"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "reported"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "invocation": {
              "type": "string"
            },
            "original": {
              "$ref": "#/$defs/CriterionResult"
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "overridden"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "original",
            "invocation"
          ]
        }
      ]
    },
    "PlanNode": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/CompiledAction"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "dependencies",
        "required",
        "action"
      ]
    }
  }
}