{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration",
  "type": "object",
  "properties": {
    "allowed_executables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CommandSpec"
      }
    },
    "coverage": {
      "$ref": "#/$defs/CoverageConfig",
      "default": {
        "producers": [],
        "reports": [],
        "roots": []
      }
    },
    "data_packs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "engine": {
      "type": "string"
    },
    "judge": {
      "$ref": "#/$defs/JudgeConfig",
      "default": {
        "model": "",
        "questions": [],
        "upload": false
      }
    },
    "managed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "releases": {
      "type": "string",
      "default": ".orly/rels"
    },
    "rules": {
      "$ref": "#/$defs/RulesConfig",
      "default": {
        "candidates": [],
        "selectors": []
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "surfaces": {
      "$ref": "#/$defs/Surfaces",
      "default": {
        "docs": [],
        "user": []
      }
    },
    "untracked_dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "packs",
    "commands",
    "allowed_executables"
  ],
  "$defs": {
    "CommandSpec": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "env_keys": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "argv"
      ]
    },
    "CoverageConfig": {
      "type": "object",
      "properties": {
        "producers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "roots",
        "producers",
        "reports"
      ]
    },
    "JudgeConfig": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upload": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "upload",
        "model",
        "questions"
      ]
    },
    "ResourceId": {
      "type": "string"
    },
    "RulesConfig": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "selectors",
        "candidates"
      ]
    },
    "Surfaces": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "user",
        "docs"
      ]
    }
  }
}