{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "orly_version": {"type": "string", "pattern": "^$|^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?(?:\\+[a-zA-Z0-9.-]+)?$"},
    "packs": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
    "managed": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
    "commands": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/nonempty", "if": {"pattern": "^burst\\."}, "then": {"pattern": "^burst\\.[a-z0-9][a-z0-9-]{0,23}$"}},
      "additionalProperties": {
        "type": "array", "minItems": 1,
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "surfaces": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "user": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
        "docs": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "reuse": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^verify\\.", "not": {"enum": ["verify.integration", "verify.memory"]}},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["hermetic", "max_age_ms", "toolchain"],
        "properties": {
          "hermetic": {"const": true},
          "max_age_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "toolchain": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}},
          "inputs": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
          "tracked_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trackedInput"}}
        }
      }
    },
    "burst": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "setup": {"$ref": "#/$defs/invocations"},
        "warm": {"$ref": "#/$defs/invocations"},
        "secrets": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"const": "OP_SERVICE_ACCOUNT_TOKEN"}},
          "additionalProperties": {"type": "string", "pattern": "^op://[^/\\u0000-\\u001f]+/[^/\\u0000-\\u001f]+/[^\\u0000-\\u001f]+$"}
        },
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
        "directories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
      }
    },
    "limits": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 2147478647},
          "output_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trackedInput": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*//)[^\\u0000\\\\*?\\[\\]{}]+$"},
    "nonempty": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
    "invocations": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}}
  }
}
