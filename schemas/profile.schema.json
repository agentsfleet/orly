{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "orly_version": {"type": "string", "pattern": "^$|^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?(?:\\+[a-zA-Z0-9.-]+)?$"},
    "packs": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
    "managed": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
    "digests": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {"type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$"}
    },
    "commands": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {
        "type": "array", "minItems": 1,
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "surfaces": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "user": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
        "docs": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "limits": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/nonempty"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 2147478647},
          "output_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      }
    },
    "execution": {
      "type": "object", "required": ["remote"], "additionalProperties": false,
      "properties": {
        "remote": {
          "type": "object", "required": ["mode"], "additionalProperties": false,
          "properties": {
            "mode": {"const": "disabled"},
            "launcher": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"allOf": [{"$ref": "#/$defs/nonempty"}, {"maxLength": 1024}]}}
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"}
  }
}
