{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "properties": {
    "builder": {
      "type": "string"
    },
    "builder_version": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "primitive": {
      "$ref": "#/$defs/Primitive"
    },
    "rule_section": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "primitive",
    "id",
    "version",
    "builder",
    "builder_version",
    "model_version",
    "candidates",
    "rule_section"
  ],
  "$defs": {
    "Primitive": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "choice"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noul"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "score"
            },
            "levels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "levels"
          ]
        }
      ]
    }
  }
}