{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageManifest",
  "type": "object",
  "properties": {
    "invocation_identity": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoveredLine"
      }
    },
    "producer": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/CriterionResult"
    },
    "snapshot_digest": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "snapshot_digest",
    "invocation_identity",
    "producer",
    "lines",
    "result"
  ],
  "$defs": {
    "CoveredLine": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "line",
        "hits"
      ]
    },
    "CriterionResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "passed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "skipped"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "reported"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "invocation": {
              "type": "string"
            },
            "original": {
              "$ref": "#/$defs/CriterionResult"
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "overridden"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "original",
            "invocation"
          ]
        }
      ]
    }
  }
}