  "rules": [
    {
      "key": "governance.registry.valid",
      "state": "active",
      "decision": "mechanical",
      "pack": "workflow.governance",
      "checker": [
        "bin/orly",
        "verify"
      ],
      "fixtures": {
        "pass": [
          "fixtures/registry-valid.json"
        ],
        "fail": [
          "fixtures/registry-invalid.json"
        ]
      }
    },
    {
      "key": "governance.render.stable",
      "state": "active",
      "decision": "mechanical",
      "pack": "workflow.governance",
      "checker": [
        "bin/orly",
        "verify"
      ],
      "fixtures": {
        "pass": [
          "src/render.test.ts"
        ],
        "fail": [
          "fixtures/unclosed-pack-block.md"
        ]
      }
    },
    {
      "key": "repository.conform",
      "state": "active",
      "decision": "repository",
      "pack": "universal.authoring",
      "command": "conform"
    }
  ],
  "helpers": {
    "gstack": {
      "source": "https://github.com/garrytan/gstack"
    },
    "egm": {
      "source": "https://github.com/google/elephant-goldfish-model"
    }
  }
