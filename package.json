{
  "name": "@agentsfleet/orly",
  "version": "0.26.0",
  "description": "Repository-scoped engineering harness: renders agent rules, materialises the gates that enforce them, and proves the PR boundary — for any coding agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "bun run --bun tsrs --noEmit"
  },
  "bin": {
    "orly": "bin/orly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsfleet/orly.git"
  },
  "homepage": "https://github.com/agentsfleet/orly#readme",
  "bugs": {
    "url": "https://github.com/agentsfleet/orly/issues"
  },
  "keywords": [
    "agents",
    "coding-agent",
    "governance",
    "git-hooks",
    "lint",
    "claude",
    "codex",
    "opencode",
    "amp"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "bin/orly",
    ".githooks/",
    "docs/*.md",
    "standards/",
    "agents/",
    "skills/orly-spec/",
    "skills/orly-build/",
    "skills/orly-ship/",
    "core/",
    "schemas/",
    "fixtures/",
    "src/",
    "registry.json",
    "AGENTS.md",
    "llms.txt",
    "SOUL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "tsrs": "0.20.0-ts7.1.0-beta"
  },
  "dependencies": {
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "zod": "4.6.7"
  }
}
