#!/usr/bin/env bash
set -uo pipefail

# git exports its repository scope to every hook. Anything we invoke below —
# make audit, the eval sandboxes, the orly suite — spawns its own git against
# OTHER directories, and an inherited GIT_DIR/GIT_INDEX_FILE silently redirects
# those calls at THIS repository: a sandbox `git add -A` in a temp
# sandbox staged fixture paths into the real index, and a linked worktree (whose
# .git is a file) broke outright. The scope dies here, before anything is run.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# AGENTS.md: "Before commit/push: gitleaks must pass." This runs on EVERY push,
# ahead of the governance branch below — a credential can land in any file, not
# only in the rule corpus.
#
# It reads no stdin (</dev/null keeps it off the ref list the loop below
# consumes) and walks full history rather than the diff, because a secret is
# only removed once every commit carrying it is gone.
#
# A repository-local `.gitleaks.toml` REPLACES the default ruleset unless it
# carries `[extend] useDefault = true`. This repository shipped one holding
# nothing but an `[allowlist]`, so gitleaks loaded zero rules and called every
# scan clean in about a millisecond. The file is deleted; the defaults apply.
# If you add one back, extend the defaults — do not replace them.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --no-banner --redact --exit-code 1 </dev/null; then
    echo "pre-push: gitleaks found a secret — remove it; suppressing needs approval" >&2
    exit 1
  fi
else
  echo "pre-push: required gitleaks is not installed — install it with mise before pushing" >&2
  exit 1
fi

GOVERNANCE_PATTERN='^((core|standards|skills|agents|schemas|src)/|(registry|repositories)\.json|AGENTS\.md|SOUL\.md|docs/ORLY_ARCHITECTURE\.md|evals/|fixtures/|\.githooks/|Makefile|README\.md|package\.json|bun\.lock|tsconfig\.json)'

governance_change=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_sha" || "$local_sha" = "0000000000000000000000000000000000000000" ]] && continue
  # A new branch, or a remote tip this clone never fetched (a force-push over
  # unseen work), has no usable range: list the commits no remote-tracking ref
  # carries instead. A list that cannot be computed runs the audit.
  if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]] &&
     files="$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null)"; then
    :
  elif ! files="$(git log --name-only --pretty=format: "$local_sha" --not --remotes)"; then
    governance_change=1
  fi
  if grep -qE "$GOVERNANCE_PATTERN" <<<"$files"; then
    governance_change=1
  fi
done

# Non-governance pushes pay nothing: the audit proves the rule corpus, and a
# push that does not touch it cannot have broken it.
if [[ $governance_change -eq 0 ]]; then
  exit 0
fi

echo "pre-push: governance changed — running deterministic audit" >&2
make audit || exit 1

# Live comprehension costs tokens on every installed agent and proves rule
# QUALITY, not distribution integrity. It is off the push path: run
# `make llmevals` by hand, or `make llmevals CHECK=1` for the zero-token
# fixture validation that `make audit` already covers.
bin/orly verify --write-evidence --llm-result not-required || exit 1
exit 0
