#!/usr/bin/env bash
set -uo pipefail

# git exports its repository scope to every hook, and a scanner that spawns its
# own git inherits it: a linked worktree (whose .git is a file) broke outright.
# The scope dies here, before anything is run.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# A push runs one check, gitleaks: "Before commit or push, gitleaks passes."
# Nothing else runs here because CI runs `make audit` on every pull request
# (.github/workflows/harness.yml), commits run `orly gate work`, and
# `orly gate pr` runs every declared verify.* command before a PR opens.
#
# It reads no stdin (</dev/null leaves the pushed ref list unread) and walks
# full history rather than the diff, because a secret is only removed once
# every commit carrying it is gone.
#
# A repository-local `.gitleaks.toml` REPLACES the default ruleset unless it
# carries `[extend] useDefault = true`. This repository shipped one holding
# nothing but an `[allowlist]`, so gitleaks loaded zero rules and called every
# scan clean in about a millisecond. Today's `.gitleaks.toml` extends the
# defaults for that reason; keep it that way.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --no-banner --redact --exit-code 1 </dev/null; then
    echo "pre-push: gitleaks found a secret — remove it; suppressing needs approval" >&2
    exit 1
  fi
else
  echo "pre-push: required gitleaks is not installed — install it with mise before pushing" >&2
  exit 1
fi

exit 0
